# ====================================================
# Distributed Secrets Vault - Environment Configuration
# ====================================================
# Copy this file to .env and update values as needed
# IMPORTANT: Never commit .env to version control
# ====================================================

# ----------------------------------------------------
# Redis Configuration
# ----------------------------------------------------
# Redis password for authentication (REQUIRED)
# Used by both Redis server and Spring Boot app
REDIS_PASSWORD=REDIS_PASSWORD

# Redis connection settings (optional - defaults work for Docker Compose)
# SPRING_DATA_REDIS_HOST=redis
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_DATABASE=0
# SPRING_DATA_REDIS_TIMEOUT=60000

# Redis Connection Pool Settings (optional - requires commons-pool2)
# SPRING_DATA_REDIS_LETTUCE_POOL_MAX_ACTIVE=8
# SPRING_DATA_REDIS_LETTUCE_POOL_MAX_IDLE=8
# SPRING_DATA_REDIS_LETTUCE_POOL_MIN_IDLE=0

# Redis SSL/TLS (optional - for production)
# SPRING_DATA_REDIS_SSL_ENABLED=false

# ----------------------------------------------------
# ScaleCube cluster (required outside full Docker Compose unless set in compose)
# ----------------------------------------------------
# DNS name used to resolve seed members; Docker Compose full stack sets this to localhost.
# SEED_DNS_HOST=localhost

# ----------------------------------------------------
# Spring Boot Configuration
# ----------------------------------------------------
# Spring profile (dev, prod, test, single)
# Controls which application-{profile}.properties file is loaded
SPRING_PROFILES_ACTIVE=dev

# Server port (optional - default: 8080)
# SERVER_PORT=8080

# Server context path (optional - default: /)
# SERVER_SERVLET_CONTEXT_PATH=/api

# ----------------------------------------------------
# Logging Configuration
# ----------------------------------------------------
# Root logging level (TRACE, DEBUG, INFO, WARN, ERROR)
# LOGGING_LEVEL_ROOT=INFO

# Application logging level
# LOGGING_LEVEL_EDU_YU_CAPSTONE=DEBUG

# Spring framework logging
# LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=INFO

