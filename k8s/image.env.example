# Copy to k8s/image.env (optional, gitignored) and adjust for your Docker Hub account.
# Used by scripts/docker-build-push.sh. Keep in sync with k8s/production/kustomization.yaml images.

DOCKERHUB_USERNAME=noambensim
DSV_IMAGE_NAME=distributed-secrets-vault
DSV_IMAGE_TAG=latest

# Full reference used for docker build/push (no docker.io prefix required for push)
DOCKERHUB_IMAGE=${DOCKERHUB_USERNAME}/${DSV_IMAGE_NAME}
